# Copier vers .env.local puis remplir

# URL canonique du site (SEO / sitemap / Open Graph)
NEXT_PUBLIC_SITE_URL=https://gpsuperenduroparis.fr

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (transactional) → https://app.brevo.com → SMTP & API → API keys
BREVO_API_KEY=
# Expéditeur = adresse du domaine vérifié chez Brevo
MAIL_FROM=contact@gpsuperenduroparis.fr
MAIL_FROM_NAME=GP SuperEnduro Paris
# Destinataire des messages formulaire (redirect OVH → Proton recommandé)
MAIL_TO=contact@gpsuperenduroparis.fr
